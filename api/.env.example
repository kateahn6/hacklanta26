# Auth0 (tenant that issues the mobile app's access tokens)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-spa-client-id
AUTH0_AUDIENCE=https://unfold-api

# Tiger Data (managed Postgres / TimescaleDB)
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# When 1, /api/analyze returns a canned response if Gemini fails or times out
DEMO_MODE=1
