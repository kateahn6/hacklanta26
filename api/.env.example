# noted! API — copy to .env and fill in. Nothing here belongs in the mobile app.

# Port the Express server listens on
PORT=8787

# --- Auth0 -----------------------------------------------------------------
# Tenant domain, no scheme and no trailing slash.
# The issuer checked on every token is https://<AUTH0_DOMAIN>/ (trailing slash).
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Identifier of the Auth0 API (not the application). Must equal the `audience`
# the mobile app sends, or every request 401s.
AUTH0_AUDIENCE=https://unfold-api
# Only used for reference/logging; the server never needs the client secret.
AUTH0_CLIENT_ID=your-auth0-native-client-id

# --- Tiger Data (managed Postgres / TimescaleDB) ---------------------------
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-3.8-flash, which is what this key can actually
# reach: 2.5-flash and 2.5-pro are 404 for new keys, and the pro models are 429
# without paid quota. Set this to a pro model once quota exists.
# GEMINI_MODEL=gemini-3.8-flash

# Optional. How long /api/analyze waits for Gemini before giving up.
# Default 15000: measured latency is median ~5.5s with a tail to ~14s.
# GEMINI_TIMEOUT_MS=15000

# When 1, /api/analyze returns a canned scrapbook page if Gemini fails or
# exceeds the timeout above, so a live demo never dies.
DEMO_MODE=1
