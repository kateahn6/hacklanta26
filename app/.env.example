# Everything the Expo app needs is public (EXPO_PUBLIC_*). No secrets here:
# the Gemini key and DATABASE_URL live only in the /api project.

# Auth0 tenant domain, no scheme
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
# Auth0 application: Native app type, Authorization Code + PKCE
EXPO_PUBLIC_AUTH0_CLIENT_ID=your-auth0-native-client-id
# Must match the Auth0 API identifier the backend checks
EXPO_PUBLIC_AUTH0_AUDIENCE=https://unfold-api
# Optional: skip the login picker and go straight to Google
EXPO_PUBLIC_AUTH0_CONNECTION=google-oauth2

# Public address of the Express API in /api, no trailing slash. NOT localhost:
# Expo Go runs on a phone, which cannot reach your laptop's loopback. Start the
# server (cd api && npm run dev), expose its PORT with a tunnel, and paste that
# URL here:
#   ngrok http 8787
#   cloudflared tunnel --url http://localhost:8787
# Changing this requires restarting Expo with a cleared cache: npx expo start -c
EXPO_PUBLIC_API_URL=https://your-tunnel-subdomain.ngrok-free.app
